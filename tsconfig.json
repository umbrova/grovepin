{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "paths": {
      "$lib/*":   ["./src/lib/*"],
      "$types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "public/manifest.json"]
}